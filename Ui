<!DOCTYPE html>
<html lang="ru" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Сайты для мастеров — сантехников, электриков, ремонтников</title>
  <meta name="description" content="Простой сайт-визитка для частного мастера: фото работ, кнопка «Позвонить», отзывы. От 5 000 ₽.">
  <style>
    /* ---------- Темы ---------- */
    :root, [data-theme="light"] {
      --bg: #ffffff;
      --bg-alt: #f3f4f6;
      --text: #111827;
      --muted: #6b7280;
      --card: #ffffff;
      --border: #e5e7eb;
      --accent: #f59e0b;
      --accent-text: #111827;
    }
    [data-theme="dark"] {
      --bg: #0b0b0c;
      --bg-alt: #161618;
      --text: #f3f4f6;
      --muted: #9ca3af;
      --card: #1c1c1f;
      --border: #2a2a2e;
      --accent: #fbbf24;
      --accent-text: #111827;
    }
    [data-theme="gray"] {
      --bg: #9ca3af;
      --bg-alt: #8b929c;
      --text: #111827;
      --muted: #1f2937;
      --card: #d1d5db;
      --border: #6b7280;
      --accent: #111827;
      --accent-text: #f9fafb;
    }

    /* ---------- База ---------- */
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      transition: background .3s, color .3s;
      padding-bottom: 80px; /* место под нижнюю кнопку на телефоне */
    }
    a { color: inherit; }
    .container { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
    section { padding: 64px 0; }
    section:nth-of-type(even) { background: var(--bg-alt); }
    h1 { font-size: clamp(28px, 5vw, 48px); line-height: 1.15; margin-bottom: 16px; }
    h2 { font-size: clamp(24px, 3.5vw, 34px); margin-bottom: 24px; }
    h3 { font-size: 20px; margin-bottom: 8px; }
    p.lead { font-size: 18px; color: var(--muted); max-width: 640px; }

    /* ---------- Шапка ---------- */
    header {
      position: sticky; top: 0; z-index: 10;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      transition: background .3s;
    }
    .nav {
      display: flex; align-items: center; justify-content: space-between;
      gap: 12px; height: 64px;
    }
    .logo { font-weight: 800; font-size: 20px; text-decoration: none; }
    .logo span { color: var(--accent); }
    [data-theme="gray"] .logo span { color: #f9fafb; }
    .nav-links { display: flex; gap: 20px; }
    .nav-links a { text-decoration: none; color: var(--muted); font-weight: 500; }
    .nav-links a:hover { color: var(--text); }
    .nav-right { display: flex; gap: 10px; align-items: center; }

    /* ---------- Кнопки ---------- */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 14px 24px; border-radius: 12px;
      font-weight: 700; font-size: 16px; text-decoration: none;
      border: 2px solid transparent; cursor: pointer;
      transition: transform .15s, opacity .15s;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn:active { transform: translateY(0); opacity: .85; }
    .btn-call { background: var(--accent); color: var(--accent-text); }
    .btn-outline { background: transparent; color: var(--text); border-color: var(--border); }
    .btn-small { padding: 8px 14px; font-size: 14px; border-radius: 10px; }

    .theme-toggle {
      background: var(--card); color: var(--text);
      border: 1px solid var(--border);
      padding: 8px 12px; border-radius: 10px;
      cursor: pointer; font-size: 14px; font-weight: 600;
      white-space: nowrap;
    }

    /* ---------- Первый экран ---------- */
    .hero { padding: 80px 0 64px; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
    .badges { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
    .badge {
      background: var(--card); border: 1px solid var(--border);
      padding: 6px 12px; border-radius: 999px; font-size: 14px; color: var(--muted);
    }

    /* ---------- Сетки и карточки ---------- */
    .grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
    .card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 16px; padding: 24px;
      transition: background .3s, border-color .3s;
    }
    .card p { color: var(--muted); }
    .icon { font-size: 32px; margin-bottom: 12px; }

    /* ---------- Примеры ---------- */
    .example { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
    .example-img {
      height: 160px; display: flex; align-items: center; justify-content: center;
      font-size: 56px;
    }
    .ex1 { background: linear-gradient(135deg, #3b82f6, #1e3a8a); }
    .ex2 { background: linear-gradient(135deg, #f59e0b, #b45309); }
    .ex3 { background: linear-gradient(135deg, #10b981, #065f46); }
    .example-body { padding: 20px 24px 24px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
    .example-body .btn { margin-top: auto; align-self: flex-start; }

    /* ---------- Цены ---------- */
    .price { font-size: 32px; font-weight: 800; margin: 8px 0; }
    .price small { font-size: 16px; font-weight: 500; color: var(--muted); }
    .card ul { list-style: none; margin-top: 12px; }
    .card li { padding: 6px 0 6px 26px; position: relative; color: var(--muted); }
    .card li::before { content: "✓"; position: absolute; left: 0; color: var(--accent); font-weight: 800; }
    [data-theme="gray"] .card li::before { color: #111827; }
    .card.featured { border: 2px solid var(--accent); }

    /* ---------- Шаги ---------- */
    .steps { counter-reset: step; }
    .step { position: relative; padding-left: 64px; }
    .step::before {
      counter-increment: step; content: counter(step);
      position: absolute; left: 20px; top: 24px;
      width: 32px; height: 32px; border-radius: 50%;
      background: var(--accent); color: var(--accent-text);
      display: flex; align-items: center; justify-content: center; font-weight: 800;
    }

    /* ---------- Вопросы ---------- */
    details {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 12px; padding: 16px 20px; margin-bottom: 12px;
    }
    summary { cursor: pointer; font-weight: 700; }
    details p { margin-top: 10px; color: var(--muted); }

    /* ---------- Контакты ---------- */
    .contact { text-align: center; }
    .contact .lead { margin: 0 auto 28px; }
    .phone-big { font-size: clamp(26px, 5vw, 40px); font-weight: 800; text-decoration: none; display: inline-block; margin-bottom: 24px; }
    .socials { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
    .social {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 12px 20px; border-radius: 12px;
      font-weight: 700; text-decoration: none; color: #fff;
      transition: transform .15s;
    }
    .social:hover { transform: translateY(-2px); }
    .social svg { width: 22px; height: 22px; fill: currentColor; }
    .wa { background: #25d366; }
    .tg { background: #229ed9; }
    .vb { background: #7360f2; }
    .sms { background: #4b5563; }

    footer { padding: 28px 0; text-align: center; color: var(--muted); font-size: 14px; border-top: 1px solid var(--border); }

    /* ---------- Кнопка снизу на телефоне ---------- */
    .sticky-call {
      display: none;
      position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 20;
      box-shadow: 0 8px 24px rgba(0,0,0,.25);
    }

    @media (max-width: 760px) {
      .nav-links { display: none; }
      .nav-right .btn-call { display: none; }
      .sticky-call { display: flex; }
      section { padding: 48px 0; }
      .hero { padding: 48px 0; }
    }
    @media (min-width: 761px) { body { padding-bottom: 0; } }
  </style>
</head>
<body>

  <!-- ===== Шапка ===== -->
  <header>
    <div class="container nav">
      <a href="#top" class="logo">Мастер<span>.</span>Сайт</a>
      <nav class="nav-links">
        <a href="#what">Что делаем</a>
